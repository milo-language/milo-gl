// gl — a safe layer over OpenGL 3.3 core.
//
// Shaders, vertex buffers, textures and offscreen targets, with the raw pointers
// and the GLuint handles kept inside. Everything here assumes a current GL
// context; creating one belongs to the window system. With SDL2 that is:
//
//   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
//   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
//   SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
//   let win = SDL_CreateWindow(..., SDL_WINDOW_OPENGL)
//   let ctx = SDL_GL_CreateContext(win)
//
// 3.3 core is the floor on purpose: it is the highest version macOS ships (it
// caps at 4.1 and only in a core profile), and it is old enough that every Mesa
// and every driver of the last decade has it.
//
// A `GlContext` owns every object made through it, and nothing here has a `Drop`.
// See the comment on GlContext for why: deleting a GL object needs its context
// current on the right thread, a destructor cannot promise either, and Milo's
// second-class references mean an object cannot hold its context alive the way a
// Rust one holds an `Arc`. So the context owns the objects instead, and teardown
// is one call at a point the program chose.
//
// You can still free an object yourself the moment you are done with it, and
// should for anything you replace mid-run. `@noCopy` makes using one after that,
// or freeing it twice, a compile error. What the context adds is the case
// `@noCopy` cannot see — forgetting.
//
//   var gl = GlContext.new()
//   var sh = Shader.compile(gl, VERT, FRAG)!
//   var quad = Mesh.fullscreenQuad(gl)
//   Gpu.clear(0.0, 0.0, 0.0, 1.0, true)
//   sh.bind()
//   sh.uniformF("time", t)
//   quad.draw()
//   gl.free()   // sweeps anything still outstanding

from "./link" import {
    glGetError
}

from "./raw" import {
    glActiveTexture, glAttachShader, glBindBuffer, glBindFramebuffer,
    glBindRenderbuffer, glBindTexture, glBindVertexArray, glBlendFunc,
    glBufferData, glCheckFramebufferStatus, glClear, glClearColor,
    glCompileShader, glCreateProgram, glCreateShader, glCullFace,
    glDeleteBuffers, glDeleteFramebuffers, glDeleteProgram, glDeleteRenderbuffers,
    glDeleteShader, glDeleteTextures, glDeleteVertexArrays, glDepthFunc,
    glDepthMask, glDisable, glDrawArrays, glEnable, glEnableVertexAttribArray,
    glFramebufferRenderbuffer, glFramebufferTexture2D, glGenBuffers,
    glGenFramebuffers, glGenRenderbuffers, glGenTextures, glGenVertexArrays,
    glFinish, glGenerateMipmap, glGetFloatv, glGetIntegerv,
    glGetProgramInfoLog, glGetProgramiv, glGetShaderInfoLog,
    glGetShaderiv, glGetString, glGetStringi, glGetUniformLocation, glLinkProgram,
    glPixelStorei, glReadPixels, glRenderbufferStorage, glShaderSource,
    glTexImage2D, glTexParameterf, glTexParameteri,
    glTexSubImage2D, glUniform1f, glUniform1i, glUniform2f, glUniform3f,
    glUniform4f, glUniformMatrix4fv, glUseProgram, glVertexAttribPointer,
    glViewport,
    GL_ARRAY_BUFFER, GL_BACK, GL_BLEND, GL_CLAMP_TO_EDGE, GL_COLOR_ATTACHMENT0,
    GL_COLOR_BUFFER_BIT, GL_COMPILE_STATUS, GL_CULL_FACE, GL_DEPTH_ATTACHMENT,
    GL_DEPTH_BUFFER_BIT, GL_DEPTH_COMPONENT24, GL_DEPTH_TEST, GL_EXTENSIONS,
    GL_FALSE,
    GL_FLOAT, GL_FRAGMENT_SHADER, GL_FRAMEBUFFER, GL_FRAMEBUFFER_COMPLETE,
    GL_LEQUAL, GL_LINEAR, GL_LINEAR_MIPMAP_LINEAR, GL_LINK_STATUS,
    GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, GL_MIRRORED_REPEAT, GL_NEAREST,
    GL_NUM_EXTENSIONS, GL_ONE,
    GL_ONE_MINUS_SRC_ALPHA, GL_R32F, GL_RED, GL_RENDERBUFFER, GL_REPEAT, GL_RGB,
    GL_RGB32F, GL_RGBA,
    GL_RGBA16F, GL_RGBA8, GL_SRC_ALPHA, GL_SRGB8, GL_SRGB8_ALPHA8,
    GL_STREAM_DRAW, GL_TEXTURE0,
    GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_TEXTURE_MAX_ANISOTROPY_EXT,
    GL_TEXTURE_MIN_FILTER,
    GL_TEXTURE_WRAP_S, GL_TEXTURE_WRAP_T, GL_TRIANGLES, GL_TRUE,
    GL_UNPACK_ALIGNMENT, GL_UNSIGNED_BYTE, GL_VERSION, GL_VERTEX_SHADER
}

// ── the context's objects ─────────────────────────────────────────────────────

// Every GL name this context has handed out, so none of them can be leaked and
// none of them can be deleted at the wrong time.
//
// This exists because the usual answer is not expressible here. In Rust every GL
// object holds an `Arc<Context>`, so the context is provably alive whenever an
// object drops and `Drop` is safe. Milo's references are second-class — a struct
// can never store a `&GlContext` — so an object cannot keep its context alive,
// and a `Drop` on it would be a `glDelete*` at a time nobody chose: possibly
// after the context is gone, possibly on a thread it was never current on. Both
// are undefined behaviour rather than a leak.
//
// So ownership runs the other way. An object still frees itself when you ask, and
// `@noCopy` still makes using one after that a compile error. What this adds is
// the case `@noCopy` cannot see: forgetting entirely. `GlContext.free` deletes
// whatever is left, once, at a point the caller picked and while the context is
// still current.
//
// One list per kind because GL has one deleter per kind. A freed slot is set to
// zero rather than removed — `glDelete*` ignores a zero name, so the sweep needs
// no compaction and an individual free stays O(1).
@noCopy
pub struct GlContext {
    programs: Vec<u32>,
    buffers: Vec<u32>,
    vaos: Vec<u32>,
    textures: Vec<u32>,
    fbos: Vec<u32>,
    rbos: Vec<u32>,
}

impl GlContext {
    // Call once, after the window system has made a context current.
    fn new(): GlContext {
        return GlContext {
            programs: Vec.new(),
            buffers: Vec.new(),
            vaos: Vec.new(),
            textures: Vec.new(),
            fbos: Vec.new(),
            rbos: Vec.new(),
        }
    }

    // How many objects this context is still holding, by kind. A number that is
    // not zero at the end of a frame loop is a leak you can see.
    fn live(self: &Self): i64 {
        return liveIn(self.programs) + liveIn(self.buffers) + liveIn(self.vaos)
            + liveIn(self.textures) + liveIn(self.fbos) + liveIn(self.rbos)
    }

    // Delete everything still outstanding. Safe to call with nothing left, which
    // is the case a program that freed everything by hand will be in.
    fn free(self: Self) {
        unsafe {
            for id in self.programs {
                if id != 0 {
                    glDeleteProgram(id)
                }
            }
            for id in self.buffers {
                if id != 0 {
                    var n = id
                    glDeleteBuffers(1, n.addrOf())
                }
            }
            for id in self.vaos {
                if id != 0 {
                    var n = id
                    glDeleteVertexArrays(1, n.addrOf())
                }
            }
            for id in self.textures {
                if id != 0 {
                    var n = id
                    glDeleteTextures(1, n.addrOf())
                }
            }
            for id in self.fbos {
                if id != 0 {
                    var n = id
                    glDeleteFramebuffers(1, n.addrOf())
                }
            }
            for id in self.rbos {
                if id != 0 {
                    var n = id
                    glDeleteRenderbuffers(1, n.addrOf())
                }
            }
        }
    }
}

fn liveIn(v: &Vec<u32>): i64 {
    var n = 0
    for id in v {
        if id != 0 {
            n = n + 1
        }
    }
    return n
}

// Zero a name that has just been deleted by hand, so the sweep does not delete it
// a second time. Linear, and deliberately: a context holds tens of objects, not
// thousands, and a map would cost more than the scan it replaced.
fn forget(v: &mut Vec<u32>, id: u32) {
    for i in 0..v.len {
        if v[i] == id {
            v[i] = 0
            return
        }
    }
}

// ── device ────────────────────────────────────────────────────────────────────

// Free functions live under `Gpu` so a call site reads as the device doing
// something, rather than as nine loose verbs in the importing module's scope.
pub struct Gpu {
}

impl Gpu {
    // The driver's GL version string, e.g. "4.1 Metal - 90.5". Useful in a
    // startup log: a context that silently fell back to 2.1 fails later, in a
    // shader compile, with an error that does not mention the version.
    fn version(): string {
        unsafe {
            let p = glGetString(GL_VERSION)
            if (p as i64) == 0 {
                return ""
            }
            return _cstrToString(p)
        }
    }

    // Whether the driver advertises an extension, by its full name including the
    // vendor prefix — "GL_EXT_texture_filter_anisotropic", not the bare suffix.
    //
    // A core profile does not answer glGetString(GL_EXTENSIONS): that returned one
    // space-separated string before 3.0 and is an error afterwards, so the list has
    // to be walked one index at a time.
    fn hasExtension(name: &string): bool {
        unsafe {
            var n: i32 = 0
            glGetIntegerv(GL_NUM_EXTENSIONS, n.addrOf())
            var i: i32 = 0
            while i < n {
                let p = glGetStringi(GL_EXTENSIONS, i as u32)
                if (p as i64) != 0 && _cstrToString(p) == name {
                    return true
                }
                i = i + 1
            }
            return false
        }
    }

    // Block until the GPU has finished everything submitted. GL commands are
    // queued, so without this a timer around a frame measures how long it took
    // to *ask* — which on a warm driver is nearly free and tells you nothing.
    fn finish() {
        unsafe {
            glFinish()
        }
    }

    // Any GL error latched since the last check. GL keeps one flag per error
    // type and clears it on read, so this drains only the first.
    fn error(): u32 {
        unsafe {
            return glGetError()
        }
    }

    fn viewport(x: i64, y: i64, w: i64, h: i64) {
        unsafe {
            glViewport(x as i32, y as i32, w as i32, h as i32)
        }
    }

    fn clear(r: f64, g: f64, b: f64, a: f64, depth: bool) {
        unsafe {
            glClearColor(r as f32, g as f32, b as f32, a as f32)
            var mask = GL_COLOR_BUFFER_BIT
            if depth {
                // A depth clear is a no-op unless depth writes are on, and a
                // pass that turned them off leaves the buffer stale rather than
                // erroring — so force them for the clear itself.
                glDepthMask(GL_TRUE)
                mask = mask | GL_DEPTH_BUFFER_BIT
            }
            glClear(mask)
        }
    }

    fn depthTest(on: bool) {
        unsafe {
            if on {
                glEnable(GL_DEPTH_TEST)
                glDepthFunc(GL_LEQUAL)
                glDepthMask(GL_TRUE)
            } else {
                glDisable(GL_DEPTH_TEST)
            }
        }
    }

    fn depthWrite(on: bool) {
        unsafe {
            if on {
                glDepthMask(GL_TRUE)
            } else {
                glDepthMask(GL_FALSE)
            }
        }
    }

    fn cullBackFaces(on: bool) {
        unsafe {
            if on {
                glEnable(GL_CULL_FACE)
                glCullFace(GL_BACK)
            } else {
                glDisable(GL_CULL_FACE)
            }
        }
    }

    fn blendOff() {
        unsafe {
            glDisable(GL_BLEND)
        }
    }

    fn blendAlpha() {
        unsafe {
            glEnable(GL_BLEND)
            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
        }
    }

    // Additive, for light. The whole point of an HDR target is that this can run
    // past 1.0 without clipping.
    fn blendAdd() {
        unsafe {
            glEnable(GL_BLEND)
            glBlendFunc(GL_ONE, GL_ONE)
        }
    }

    // `src.rgb + dst.rgb * (1 - src.a)` — alpha as coverage, colour already
    // scaled by it.
    //
    // This is what a compositing layer wants and `blendAlpha` is not. With
    // straight alpha a layer can only replace what is under it in proportion to
    // how opaque it is, so a purely additive mark (a glow, a spark, a HUD stroke)
    // has to claim opacity it does not have in order to be visible at all, and
    // then it hides the frame behind it. Premultiplied separates the two: rgb is
    // the light this layer emits, alpha is how much of the layer beneath it
    // blocks, and either can be zero.
    fn blendPremultiplied() {
        unsafe {
            glEnable(GL_BLEND)
            glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
        }
    }
}

// ── shaders ───────────────────────────────────────────────────────────────────

@noCopy
pub struct Shader {
    id: u32,
}

impl Shader {
    // Compile and link a vertex/fragment pair. The error is the driver's own log,
    // which names the line — there is nothing this module could add to it.
    fn compile(gl: &mut GlContext, vert: &string, frag: &string): Result<Shader, string> {
        unsafe {
            let vs = compileStage(GL_VERTEX_SHADER, vert)?
            let fs = compileStage(GL_FRAGMENT_SHADER, frag)?
            let prog = glCreateProgram()
            glAttachShader(prog, vs)
            glAttachShader(prog, fs)
            glLinkProgram(prog)
            // Attached shaders are reference-counted by the program, so deleting
            // them here frees the compiler's copy and keeps the linked code.
            glDeleteShader(vs)
            glDeleteShader(fs)
            var ok: i32 = 0
            glGetProgramiv(prog, GL_LINK_STATUS, ok.addrOf())
            if ok == 0 {
                let log = programLog(prog)
                glDeleteProgram(prog)
                return Result.Err("link failed: " + log)
            }
            gl.programs.push(prog)
            return Result.Ok(Shader {
                id: prog
            }
            )
        }
    }

    fn bind(self: &Self) {
        unsafe {
            glUseProgram(self.id)
        }
    }

    // Uniform setters bind the program first: forgetting to is the single most
    // common way a uniform silently goes to whichever shader ran last.
    fn uniformI(self: &Self, name: &string, v: i64) {
        unsafe {
            glUseProgram(self.id)
            glUniform1i(self.loc(name), v as i32)
        }
    }

    fn uniformF(self: &Self, name: &string, v: f64) {
        unsafe {
            glUseProgram(self.id)
            glUniform1f(self.loc(name), v as f32)
        }
    }

    fn uniform2F(self: &Self, name: &string, a: f64, b: f64) {
        unsafe {
            glUseProgram(self.id)
            glUniform2f(self.loc(name), a as f32, b as f32)
        }
    }

    fn uniform3F(self: &Self, name: &string, a: f64, b: f64, c: f64) {
        unsafe {
            glUseProgram(self.id)
            glUniform3f(self.loc(name), a as f32, b as f32, c as f32)
        }
    }

    fn uniform4F(self: &Self, name: &string, a: f64, b: f64, c: f64, d: f64) {
        unsafe {
            glUseProgram(self.id)
            glUniform4f(self.loc(name), a as f32, b as f32, c as f32, d as f32)
        }
    }

    // A 4x4 matrix in column-major order — sixteen floats, the layout GLSL's
    // `mat4` already has, so `transpose` stays false and nothing reorders.
    fn uniformMat4(self: &Self, name: &string, m: &Vec<f32>) {
        unsafe {
            glUseProgram(self.id)
            glUniformMatrix4fv(self.loc(name), 1, GL_FALSE, m.ptr())
        }
    }

    // Bind `tex` to texture unit `unit` and point the sampler at it.
    fn sampler(self: &Self, name: &string, tex: &Texture2D, unit: i64) {
        tex.bind(unit)
        self.uniformI(name, unit)
    }

    // -1 for a name the linker dropped, which every glUniform* call ignores. A
    // dead uniform is a normal thing (an unused branch of a shader), so this is
    // not an error.
    fn loc(self: &Self, name: &string): i32 {
        unsafe {
            return glGetUniformLocation(self.id, name)
        }
    }

    // Deleting early is fine and often right — a shader you are replacing should
    // not wait for teardown. Handing the context back the name is what keeps the
    // final sweep from deleting it a second time.
    fn free(self: Self, gl: &mut GlContext) {
        unsafe {
            glDeleteProgram(self.id)
        }
        forget(&mut gl.programs, self.id)
    }
}

fn compileStage(kind: u32, src: &string): Result<u32, string> {
    unsafe {
        let sh = glCreateShader(kind)
        // glShaderSource wants a `const char* const*`, so the source's address
        // has to exist as a value before it can be pointed at.
        var p = _strDataPtr(src)
        glShaderSource(sh, 1, p.addrOf(), 0 as *i32)
        glCompileShader(sh)
        var ok: i32 = 0
        glGetShaderiv(sh, GL_COMPILE_STATUS, ok.addrOf())
        if ok == 0 {
            let log = shaderLog(sh)
            glDeleteShader(sh)
            var what = "vertex"
            if kind == GL_FRAGMENT_SHADER {
                what = "fragment"
            }
            return Result.Err(what + " shader: " + log)
        }
        return Result.Ok(sh)
    }
}

pub let LOG_CAP: i64 = 4096

fn shaderLog(sh: u32): string {
    unsafe {
        var buf: Vec<u8> = Vec.filled(LOG_CAP, 0)
        var n: i32 = 0
        glGetShaderInfoLog(sh, LOG_CAP as i32, n.addrOf(), buf.ptr())
        return _bytesToString(buf.ptr() as *u8, n as i64)
    }
}

fn programLog(prog: u32): string {
    unsafe {
        var buf: Vec<u8> = Vec.filled(LOG_CAP, 0)
        var n: i32 = 0
        glGetProgramInfoLog(prog, LOG_CAP as i32, n.addrOf(), buf.ptr())
        return _bytesToString(buf.ptr() as *u8, n as i64)
    }
}

// ── meshes ────────────────────────────────────────────────────────────────────

// A vertex array plus the one interleaved float buffer it reads. `attrs` is the
// component count of each attribute in order — [3, 2, 4] is a vec3 at location
// 0, a vec2 at 1 and a vec4 at 2, packed tightly, which is the layout every
// shader in this module expects.
@noCopy
pub struct Mesh {
    vao: u32,
    vbo: u32,
    floatsPerVertex: i64,
    vertices: i64,
}

impl Mesh {
    fn new(gl: &mut GlContext, attrs: &Vec<i64>): Mesh {
        // Zero attributes means a zero-float vertex, which makes `upload` divide by
        // zero to count vertices — a confusing trap two calls away from the mistake.
        assert(attrs.len > 0, "Mesh.new: needs at least one vertex attribute")
        unsafe {
            var vao: u32 = 0
            var vbo: u32 = 0
            glGenVertexArrays(1, vao.addrOf())
            glGenBuffers(1, vbo.addrOf())
            glBindVertexArray(vao)
            glBindBuffer(GL_ARRAY_BUFFER, vbo)
            var total = 0
            for a in attrs {
                total = total + a
            }
            let stride = (total * 4) as i32
            var off = 0
            var i = 0
            while i < attrs.len {
                let n = attrs[i]
                glEnableVertexAttribArray(i as u32)
                glVertexAttribPointer(i as u32, n as i32, GL_FLOAT, GL_FALSE, stride, (off * 4) as *u8)
                off = off + n
                i = i + 1
            }
            glBindVertexArray(0)
            gl.vaos.push(vao)
            gl.buffers.push(vbo)
            return Mesh {
                vao: vao, vbo: vbo, floatsPerVertex: total, vertices: 0
            }
        }
    }

    // Replace the whole buffer. GL_STREAM_DRAW plus a full respecify is the
    // orphaning idiom: the driver hands back a fresh allocation instead of
    // stalling until the last frame's draw has finished reading the old one.
    fn upload(self: &mut Self, data: &Vec<f32>) {
        // A partial trailing vertex is silently truncated by the integer divide, so
        // the draw is short by one triangle with nothing to point at.
        assert(data.len % self.floatsPerVertex == 0, "Mesh.upload: data length is not a whole number of vertices")
        unsafe {
            glBindBuffer(GL_ARRAY_BUFFER, self.vbo)
            glBufferData(GL_ARRAY_BUFFER, (data.len * 4) as i64, data.ptr() as *u8, GL_STREAM_DRAW)
            self.vertices = data.len / self.floatsPerVertex
        }
    }

    fn draw(self: &Self) {
        if self.vertices == 0 {
            return
        }
        unsafe {
            glBindVertexArray(self.vao)
            glDrawArrays(GL_TRIANGLES, 0, self.vertices as i32)
            glBindVertexArray(0)
        }
    }

    // Two triangles covering clip space, with UVs — the input to every
    // post-processing pass. Position is vec2 at location 0, UV vec2 at 1.
    fn fullscreenQuad(gl: &mut GlContext): Mesh {
        var attrs: Vec<i64> = Vec.new()
        attrs.push(2)
        attrs.push(2)
        var m = Mesh.new(&mut gl, attrs)
        var v: Vec<f32> = Vec.new()
        pushQuadVertex(&mut v, -1.0, -1.0, 0.0, 0.0)
        pushQuadVertex(&mut v, 1.0, -1.0, 1.0, 0.0)
        pushQuadVertex(&mut v, 1.0, 1.0, 1.0, 1.0)
        pushQuadVertex(&mut v, -1.0, -1.0, 0.0, 0.0)
        pushQuadVertex(&mut v, 1.0, 1.0, 1.0, 1.0)
        pushQuadVertex(&mut v, -1.0, 1.0, 0.0, 1.0)
        m.upload(v)
        return m
    }

    fn free(self: Self, gl: &mut GlContext) {
        unsafe {
            glDeleteBuffers(1, self.vbo.addrOf())
            glDeleteVertexArrays(1, self.vao.addrOf())
        }
        forget(&mut gl.buffers, self.vbo)
        forget(&mut gl.vaos, self.vao)
    }
}

fn pushQuadVertex(v: &mut Vec<f32>, x: f32, y: f32, u: f32, t: f32) {
    v.push(x)
    v.push(y)
    v.push(u)
    v.push(t)
}

// The vertex shader for a fullscreen pass, paired with `Mesh.fullscreenQuad`.
pub let QUAD_VERT: string = "#version 330 core
layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aUv;
out vec2 vUv;
void main() {
    vUv = aUv;
    gl_Position = vec4(aPos, 0.0, 1.0);
}
"

// ── textures ──────────────────────────────────────────────────────────────────

// How a UV outside 0..1 addresses the texture.
//
// `Clamp` is the default every constructor here starts from, and it is the right
// answer for a texture that is a picture of the whole frame: a blur tap that runs
// off the edge should read the edge texel, not wrap round and drag the far side
// of the image in.
//
// `Repeat` is for a texture that tiles — a detail pattern laid over terrain, where
// the UV is world position over a fixed period and is expected to run to hundreds.
//
// `Mirror` repeats but flips on every other period, so there is no seam where the
// pattern restarts. It is also what a finite map wants when the world around it
// reflects rather than wraps: the imagery has to fold on exactly the same period
// as the geometry or the two disagree at every edge.
pub enum Wrap {
    Clamp,
    Repeat,
    Mirror,
}

@noCopy
pub struct Texture2D {
    id: u32,
    w: i64,
    h: i64,
}

impl Texture2D {
    // Three sRGB bytes per pixel — the layout a PNG decodes to and the one an
    // aerial photograph or a hand-authored sheet is already in.
    //
    // The point of GL_SRGB8 over GL_RGB8 is that the sampler decodes to linear in
    // hardware, before filtering. Doing it afterwards on the shader side is both
    // slower and wrong: a bilinear tap averages four sRGB bytes, and the average
    // of two sRGB values is not the sRGB of their linear average, so edges come
    // out darker than they should. Passing bytes through a 256-entry lookup table
    // per fetch has the same flaw and costs a dependent read.
    fn srgb8(gl: &mut GlContext, w: i64, h: i64, pixels: &Vec<u8>, smooth: bool): Texture2D {
        assert(pixels.len >= w * h * 3, "Texture2D.srgb8: pixels is shorter than w*h*3")
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_SRGB8, w as i32, h as i32, 0, GL_RGB, GL_UNSIGNED_BYTE, pixels.ptr() as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    // An 8-bit RGBA texture from packed ABGR8888 words — the same layout the
    // software renderers here hand to SDL, so a CPU framebuffer uploads with no
    // repacking.
    fn rgba8(gl: &mut GlContext, w: i64, h: i64, pixels: &Vec<u32>, smooth: bool): Texture2D {
        // The driver reads w*h words off this pointer with no idea how long the
        // Vec is. A short one is a heap over-read the caller never wrote an
        // `unsafe` for, so the width/height claim is checked here or nowhere.
        assert(pixels.len >= w * h, "Texture2D.rgba8: pixels is shorter than w*h")
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w as i32, h as i32, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.ptr() as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    // Three floats per pixel of unbounded linear light. This is the format an
    // HDR canvas is already in, so uploading one is a straight memcpy.
    fn rgb32f(gl: &mut GlContext, w: i64, h: i64, pixels: &Vec<f32>, smooth: bool): Texture2D {
        assert(pixels.len >= w * h * 3, "Texture2D.rgb32f: pixels is shorter than w*h*3")
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB32F, w as i32, h as i32, 0, GL_RGB, GL_FLOAT, pixels.ptr() as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    // One float per pixel. A depth buffer, a mask, a heightfield — anything the
    // CPU computed per pixel and the shader needs to read back.
    fn r32f(gl: &mut GlContext, w: i64, h: i64, pixels: &Vec<f32>, smooth: bool): Texture2D {
        assert(pixels.len >= w * h, "Texture2D.r32f: pixels is shorter than w*h")
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_R32F, w as i32, h as i32, 0, GL_RED, GL_FLOAT, pixels.ptr() as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    // Allocated but not filled — for a texture whose contents arrive later, or
    // whose useful area is smaller than the allocation.
    fn r32fEmpty(gl: &mut GlContext, w: i64, h: i64, smooth: bool): Texture2D {
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_R32F, w as i32, h as i32, 0, GL_RED, GL_FLOAT, 0 as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    // Write a w x h block into the bottom-left corner. Lets one fixed allocation
    // serve inputs of varying size, which beats reallocating a texture mid-frame.
    fn updateR32fRegion(self: &Self, w: i64, h: i64, pixels: &Vec<f32>) {
        // Two ways to run off the end here, not one: a short Vec, and a region
        // larger than the allocation it is being written into.
        assert(pixels.len >= w * h, "Texture2D.updateR32fRegion: pixels is shorter than w*h")
        assert(w <= self.w && h <= self.h, "Texture2D.updateR32fRegion: region is larger than the texture")
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w as i32, h as i32, GL_RED, GL_FLOAT, pixels.ptr() as *u8)
        }
    }

    fn updateR32f(self: &Self, pixels: &Vec<f32>) {
        assert(pixels.len >= self.w * self.h, "Texture2D.updateR32f: pixels is shorter than the texture")
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, self.w as i32, self.h as i32, GL_RED, GL_FLOAT, pixels.ptr() as *u8)
        }
    }

    // An empty half-float target, for a framebuffer to render into. Half is
    // enough for light that has already been exposed, and halves the bandwidth
    // of every blur tap against RGBA32F.
    fn rgba16f(gl: &mut GlContext, w: i64, h: i64, smooth: bool): Texture2D {
        unsafe {
            let id = newTexture(&mut gl, smooth)
            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, w as i32, h as i32, 0, GL_RGBA, GL_FLOAT, 0 as *u8)
            return Texture2D {
                id: id, w: w, h: h
            }
        }
    }

    fn updateRgb32f(self: &Self, pixels: &Vec<f32>) {
        assert(pixels.len >= self.w * self.h * 3, "Texture2D.updateRgb32f: pixels is shorter than the texture")
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, self.w as i32, self.h as i32, GL_RGB, GL_FLOAT, pixels.ptr() as *u8)
        }
    }

    fn updateRgba8(self: &Self, pixels: &Vec<u32>) {
        assert(pixels.len >= self.w * self.h, "Texture2D.updateRgba8: pixels is shorter than the texture")
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, self.w as i32, self.h as i32, GL_RGBA, GL_UNSIGNED_BYTE, pixels.ptr() as *u8)
        }
    }

    // Change how UVs outside 0..1 address this texture. Every constructor starts
    // at `Wrap.Clamp`; this is separate from them rather than a parameter on each
    // because it is a property of how the texture is *used*, and the same upload
    // path serves a tiling detail texture and a full-frame image.
    fn setWrap(self: &Self, wrap: Wrap) {
        var mode = GL_CLAMP_TO_EDGE
        match wrap {
            Wrap.Clamp => {
            }
            Wrap.Repeat => {
                mode = GL_REPEAT as i32
            }
            Wrap.Mirror => {
                mode = GL_MIRRORED_REPEAT
            }
        }
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, mode)
            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, mode)
        }
    }

    // Build the mip chain and switch minification to trilinear.
    //
    // Call it AFTER the pixels are uploaded — it derives the smaller levels from
    // level 0, so on an empty texture it fills the chain with nothing.
    //
    // This is not optional for a texture that tiles across a 3D surface. Without
    // mips, a pattern seen at a distance samples one texel out of every dozen the
    // pixel covers, and which texel that is changes as the camera moves: the
    // ground crawls and glitters. Mips are what make a far-off surface settle.
    fn generateMipmaps(self: &Self) {
        unsafe {
            glBindTexture(GL_TEXTURE_2D, self.id)
            glGenerateMipmap(GL_TEXTURE_2D)
            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR as i32)
        }
    }

    // Sharpen a mipmapped texture seen at a grazing angle, up to `want` samples.
    //
    // Trilinear picks one mip level for the whole pixel from its widest axis, so
    // ground stretching to the horizon is blurred along the direction it is NOT
    // compressed in — the road surface goes to mud a hundred metres out while
    // still being perfectly sharp sideways. Anisotropic filtering takes several
    // samples along the long axis instead.
    //
    // Silently does nothing without GL_EXT_texture_filter_anisotropic (not core
    // until 4.6) and clamps to the driver's maximum, so `setAnisotropy(16.0)` is
    // always a safe thing to ask for. Needs mips: it selects between levels.
    fn setAnisotropy(self: &Self, want: f64) {
        if !Gpu.hasExtension("GL_EXT_texture_filter_anisotropic") {
            return
        }
        unsafe {
            var most: f32 = 1.0
            glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, most.addrOf())
            var use = want
            if use > (most as f64) {
                use = most as f64
            }
            if use < 1.0 {
                use = 1.0
            }
            glBindTexture(GL_TEXTURE_2D, self.id)
            glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, use as f32)
        }
    }

    fn bind(self: &Self, unit: i64) {
        unsafe {
            glActiveTexture(GL_TEXTURE0 + (unit as u32))
            glBindTexture(GL_TEXTURE_2D, self.id)
        }
    }

    fn free(self: Self, gl: &mut GlContext) {
        unsafe {
            glDeleteTextures(1, self.id.addrOf())
        }
        forget(&mut gl.textures, self.id)
    }
}

fn newTexture(gl: &mut GlContext, smooth: bool): u32 {
    unsafe {
        var id: u32 = 0
        glGenTextures(1, id.addrOf())
        gl.textures.push(id)
        glBindTexture(GL_TEXTURE_2D, id)
        // Rows of a float canvas are 3 floats per pixel and so never 4-byte
        // aligned at an odd width; the default alignment of 4 shears the image.
        glPixelStorei(GL_UNPACK_ALIGNMENT, 1)
        var filter = GL_NEAREST as i32
        if smooth {
            filter = GL_LINEAR as i32
        }
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter)
        // Clamp, not repeat: a blur tap that runs off the edge should read the
        // edge texel, not wrap round and drag the far side of the frame in.
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE)
        return id
    }
}

// ── offscreen targets ─────────────────────────────────────────────────────────

// A framebuffer with one colour texture and, optionally, a depth buffer.
@noCopy
pub struct Target {
    fbo: u32,
    depth: u32, // renderbuffer id, 0 when the target has no depth
    tex: Texture2D,
    w: i64,
    h: i64,
}

impl Target {
    fn new(gl: &mut GlContext, w: i64, h: i64, depth: bool, smooth: bool): Result<Target, string> {
        unsafe {
            let tex = Texture2D.rgba16f(&mut gl, w, h, smooth)
            var fbo: u32 = 0
            glGenFramebuffers(1, fbo.addrOf())
            gl.fbos.push(fbo)
            glBindFramebuffer(GL_FRAMEBUFFER, fbo)
            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex.id, 0)
            var rb: u32 = 0
            if depth {
                glGenRenderbuffers(1, rb.addrOf())
                gl.rbos.push(rb)
                glBindRenderbuffer(GL_RENDERBUFFER, rb)
                glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, w as i32, h as i32)
                glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, rb)
            }
            let status = glCheckFramebufferStatus(GL_FRAMEBUFFER)
            glBindFramebuffer(GL_FRAMEBUFFER, 0)
            if status != GL_FRAMEBUFFER_COMPLETE {
                // Nothing is handed back on this path, so nothing the caller holds
                // could free these — an Err would otherwise leak a texture, a
                // renderbuffer and an FBO per attempt.
                if rb != 0 {
                    var d = rb
                    glDeleteRenderbuffers(1, d.addrOf())
                    forget(&mut gl.rbos, rb)
                }
                var f2 = fbo
                glDeleteFramebuffers(1, f2.addrOf())
                forget(&mut gl.fbos, fbo)
                tex.free(&mut gl)
                return Result.Err($"framebuffer incomplete: 0x{status}")
            }
            return Result.Ok(Target {
                fbo: fbo, depth: rb, tex: tex, w: w, h: h
            }
            )
        }
    }

    // Bind and set the viewport together. Every bug where a quarter-resolution
    // pass rendered into the top-left sixteenth of its own target was these two
    // lines drifting apart.
    fn bind(self: &Self) {
        unsafe {
            glBindFramebuffer(GL_FRAMEBUFFER, self.fbo)
            glViewport(0, 0, self.w as i32, self.h as i32)
        }
    }

    // Bind what this target rendered as an input to the next pass. The colour
    // texture is not handed out as a value on purpose: a second `Texture2D`
    // holding the same GL name would be a second thing that thinks it may free
    // it, and second-class references mean it cannot be lent out either.
    fn bindTexture(self: &Self, unit: i64) {
        self.tex.bind(unit)
    }

    fn free(self: Self, gl: &mut GlContext) {
        unsafe {
            if self.depth != 0 {
                glDeleteRenderbuffers(1, self.depth.addrOf())
                forget(&mut gl.rbos, self.depth)
            }
            glDeleteFramebuffers(1, self.fbo.addrOf())
        }
        forget(&mut gl.fbos, self.fbo)
        self.tex.free(&mut gl)
    }
}

// Read back the bound framebuffer as ABGR8888 words — the layout SDL textures
// and the software canvases here already use, so a frame read off the GPU can be
// written straight out as a screenshot. Row 0 is the BOTTOM of the image in GL's
// convention; flip it if you are writing PPM or PNG.
//
// This stalls the pipeline until the GPU has caught up, which is exactly what a
// headless smoke test wants and exactly what a frame loop does not.
pub fn readPixelsRgba8(w: i64, h: i64): Vec<u32> {
    var out: Vec<u32> = Vec.filled(w * h, 0)
    unsafe {
        glReadPixels(0, 0, w as i32, h as i32, GL_RGBA, GL_UNSIGNED_BYTE, out.ptr() as *u8)
    }
    return out
}

// Render to the window again. `w`/`h` are the drawable size in pixels, which on
// a Retina display is not the window size — ask SDL_GL_GetDrawableSize, not
// SDL_GetWindowSize, or half the frame goes missing.
pub fn bindScreen(w: i64, h: i64) {
    unsafe {
        glBindFramebuffer(GL_FRAMEBUFFER, 0)
        glViewport(0, 0, w as i32, h as i32)
    }
}
